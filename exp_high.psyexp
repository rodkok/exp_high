        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import random&amp;#10;win.mouseVisible = True&amp;#10;allItems = data.importConditions(&quot;exp_stimuli_high.xlsx&quot;)&amp;#10;&amp;#10;itemsByCategory = {}&amp;#10;&amp;#10;for row in allItems:&amp;#10;    cat = row[&quot;category&quot;]&amp;#10;&amp;#10;    if cat not in itemsByCategory:&amp;#10;        itemsByCategory[cat] = []&amp;#10;&amp;#10;    itemsByCategory[cat].append(row)&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="psychoJS.window.mouseVisible = true;&amp;#10;&amp;#10;allItems = TrialHandler.importConditions(&amp;#10;    psychoJS.serverManager,&amp;#10;    &quot;exp_stimuli_high.xlsx&quot;&amp;#10;);&amp;#10;&amp;#10;itemsByCategory = {};&amp;#10;&amp;#10;for (let row of allItems) {&amp;#10;    let cat = row[&quot;category&quot;];&amp;#10;&amp;#10;    if (!(cat in itemsByCategory)) {&amp;#10;        itemsByCategory[cat] = [];&amp;#10;    }&amp;#10;&amp;#10;    itemsByCategory[cat].push(row);&amp;#10;}" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="target = {&amp;#10;    &quot;category&quot;: category,&amp;#10;    &quot;name&quot;: name,&amp;#10;    &quot;stimuli&quot;: stimuli&amp;#10;};&amp;#10;&amp;#10;sameCategoryItems = itemsByCategory[category];&amp;#10;&amp;#10;possibleDistractors = [];&amp;#10;&amp;#10;for (let item of sameCategoryItems) {&amp;#10;    if (item[&quot;stimuli&quot;] !== stimuli) {&amp;#10;        possibleDistractors.push(item);&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// выбираем 7 случайных дистракторов&amp;#10;possibleDistractors = possibleDistractors.sort(() =&gt; Math.random() - 0.5);&amp;#10;distractors = possibleDistractors.slice(0, 7);&amp;#10;&amp;#10;cards = distractors.concat([target]);&amp;#10;&amp;#10;// перемешиваем 8 карточек&amp;#10;cards = cards.sort(() =&gt; Math.random() - 0.5);&amp;#10;&amp;#10;img1 = cards[0][&quot;stimuli&quot;];&amp;#10;img2 = cards[1][&quot;stimuli&quot;];&amp;#10;img3 = cards[2][&quot;stimuli&quot;];&amp;#10;img4 = cards[3][&quot;stimuli&quot;];&amp;#10;img5 = cards[4][&quot;stimuli&quot;];&amp;#10;img6 = cards[5][&quot;stimuli&quot;];&amp;#10;img7 = cards[6][&quot;stimuli&quot;];&amp;#10;img8 = cards[7][&quot;stimuli&quot;];&amp;#10;&amp;#10;targetPos = null;&amp;#10;&amp;#10;for (let i = 0; i &lt; cards.length; i++) {&amp;#10;    if (cards[i][&quot;stimuli&quot;] === stimuli) {&amp;#10;        targetPos = i + 1;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;target_name = name;&amp;#10;target_image = stimuli;&amp;#10;target_category = category;&amp;#10;&amp;#10;clicked_target = 0;&amp;#10;rt_target = &quot;&quot;;&amp;#10;&amp;#10;mouse.clickReset();&amp;#10;mouse_was_down = false;&amp;#10;&amp;#10;imageList = [&amp;#10;    image,&amp;#10;    image_2,&amp;#10;    image_3,&amp;#10;    image_4,&amp;#10;    image_5,&amp;#10;    image_6,&amp;#10;    image_7,&amp;#10;    image_8&amp;#10;];&amp;#10;&amp;#10;targetObject = imageList[targetPos - 1];" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="target = {&amp;#10;    &quot;category&quot;: category,&amp;#10;    &quot;name&quot;: name,&amp;#10;    &quot;stimuli&quot;: stimuli&amp;#10;}&amp;#10;&amp;#10;sameCategoryItems = itemsByCategory[category]&amp;#10;&amp;#10;possibleDistractors = []&amp;#10;&amp;#10;for item in sameCategoryItems:&amp;#10;    if item[&quot;stimuli&quot;] != stimuli:&amp;#10;        possibleDistractors.append(item)&amp;#10;&amp;#10;distractors = random.sample(possibleDistractors, 7)&amp;#10;&amp;#10;cards = distractors + [target]&amp;#10;&amp;#10;random.shuffle(cards)&amp;#10;&amp;#10;img1 = cards[0][&quot;stimuli&quot;]&amp;#10;img2 = cards[1][&quot;stimuli&quot;]&amp;#10;img3 = cards[2][&quot;stimuli&quot;]&amp;#10;img4 = cards[3][&quot;stimuli&quot;]&amp;#10;img5 = cards[4][&quot;stimuli&quot;]&amp;#10;img6 = cards[5][&quot;stimuli&quot;]&amp;#10;img7 = cards[6][&quot;stimuli&quot;]&amp;#10;img8 = cards[7][&quot;stimuli&quot;]&amp;#10;&amp;#10;targetPos = None&amp;#10;&amp;#10;for i, card in enumerate(cards):&amp;#10;    if card[&quot;stimuli&quot;] == stimuli:&amp;#10;        targetPos = i + 1&amp;#10;&amp;#10;target_name = name&amp;#10;target_image = stimuli&amp;#10;target_category = category&amp;#10;&amp;#10;clicked_target = 0&amp;#10;rt_target = &quot;&quot;&amp;#10;&amp;#10;mouse.clickReset()&amp;#10;&amp;#10;imageList = [&amp;#10;    image,&amp;#10;    image_2,&amp;#10;    image_3,&amp;#10;    image_4,&amp;#10;    image_5,&amp;#10;    image_6,&amp;#10;    image_7,&amp;#10;    image_8&amp;#10;]&amp;#10;&amp;#10;targetObject = imageList[targetPos - 1]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="buttons = mouse.getPressed()&amp;#10;&amp;#10;if buttons[0] and not mouse_was_down:&amp;#10;    if targetObject.contains(mouse):&amp;#10;        clicked_target = 1&amp;#10;        rt_target = mouse.mouseClock.getTime()&amp;#10;        continueRoutine = False&amp;#10;&amp;#10;    mouse_was_down = True&amp;#10;&amp;#10;if not buttons[0]:&amp;#10;    mouse_was_down = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="buttons = mouse.getPressed();&amp;#10;&amp;#10;if ((buttons[0] &amp;&amp; (!mouse_was_down))) {&amp;#10;    if (targetObject.contains(mouse)) {&amp;#10;        clicked_target = 1;&amp;#10;        rt_target = t;&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;&amp;#10;    mouse_was_down = true;&amp;#10;}&amp;#10;&amp;#10;if ((!buttons[0])) {&amp;#10;    mouse_was_down = false;&amp;#10;}" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;clicked_target&quot;, clicked_target);&amp;#10;psychoJS.experiment.addData(&quot;rt_target&quot;, rt_target);&amp;#10;psychoJS.experiment.addData(&quot;target_name&quot;, target_name);&amp;#10;psychoJS.experiment.addData(&quot;target_image&quot;, target_image);&amp;#10;psychoJS.experiment.addData(&quot;target_category&quot;, target_category);&amp;#10;psychoJS.experiment.addData(&quot;target_position&quot;, targetPos);" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData(&quot;clicked_target&quot;, clicked_target)&amp;#10;thisExp.addData(&quot;rt_target&quot;, rt_target)&amp;#10;thisExp.addData(&quot;target_name&quot;, target_name)&amp;#10;thisExp.addData(&quot;target_image&quot;, target_image)&amp;#10;thisExp.addData(&quot;target_category&quot;, target_category)&amp;#10;thisExp.addData(&quot;target_position&quot;, targetPos)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <ImageComponent name="bkg_image" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="$[1,1,1]" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="bool" updates="constant" name="flipHoriz"/>
        <Param val="False" valType="bool" updates="constant" name="flipVert"/>
        <Param val="marketplace_exp.png" valType="file" updates="constant" name="image"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="" valType="str" updates="constant" name="mask"/>
        <Param val="bkg_image" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="(1920/1080, 1080/1080)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
