    <Param val="['audio_exp.mp3', 'bootsarcticdrift.png', 'bootsarctichunter.png', 'bootsarcticsnow.png', 'bootsfrostpeak.png', 'bootsfrostridge.png', 'bootsglacierridge.png', 'bootsglaciertrek.png', 'bootsnordway.png', 'bootsnorthridge.png', 'bootsnorthtrail.png', 'bootspolardrift.png', 'bootspolarfox.png', 'bootspolarhunter.png', 'bootssibir.png', 'bootssnowranger.png', 'bootssnowridge.png', 'bootssnowway.png', 'bootstaiga.png', 'bootswinterfox.png', 'bootswintertrail.png', 'exp_stimuli_high.xlsx', 'hatarcticline.png', 'hatarcticpeak.png', 'hatarcticridge.png', 'hatfrostline.png', 'hatfrostpeak.png', 'hatfrostridge.png', 'hatglacierline.png', 'hatglacierpeak.png', 'hatglacierwarm.png', 'hatnorthpeak.png', 'hatnorthridge.png', 'hatnorthwind.png', 'hatpolarline.png', 'hatpolarridge.png', 'hatpolarsnow.png', 'hatsnowpeak.png', 'hatsnowridge.png', 'hatwinterline.png', 'hatwinterpeak.png', 'hatwinterridge.png', 'jacketarcticridge.png', 'jacketarcticwear.png', 'jacketfrostarctic.png', 'jacketfrostline.png', 'jacketfrostridge.png', 'jacketglacierpro.png', 'jacketglacierstorm.png', 'jacketicetrail.png', 'jacketnorthpeak.png', 'jacketnorthridge.png', 'jacketnorthwind.png', 'jacketpolarstyle.png', 'jacketsnowear.png', 'jacketsnowpeak.png', 'jacketsnowridge.png', 'jacketsnowridge2.png', 'jacketwinterpeak.png', 'jacketwinterridge.png', 'jacketwinterstorm.png', 'jacketwinterwind.png', 'marketplace_exp.png', 'pantsaarcticridge.png', 'pantsarcticfit.png', 'pantsarcticridge.png', 'pantsarcticstorm.png', 'pantsfrostridge.png', 'pantsfrosttrail.png', 'pantsfrostwear.png', 'pantsglacierridge.png', 'pantsglacierwalk.png', 'pantsnorthline.png', 'pantsnorthridge.png', 'pantsnorthtrek.png', 'pantspolarmove.png', 'pantspolartrek.png', 'pantssnowmotion.png', 'pantssnowridge.png', 'pantssnowridge2.png', 'pantssnowstep.png', 'pantswintertrek.png', 'pantswwinterwear.png']" valType="list" updates="None" name="Resources"/>
